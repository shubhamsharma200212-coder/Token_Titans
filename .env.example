# GEMINI_API_KEY: Required for Gemini AI API calls (google-genai SDK).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: SQLAlchemy database connection string (defaults to SQLite locally).
# For optional MySQL connection, set: mysql+pymysql://user:password@localhost:3306/careermatch
DATABASE_URL="sqlite:///careermatch.db"

